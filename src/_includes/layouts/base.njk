<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} @ geff.re</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="author" content="{{ site.author }}">
  <meta name="generator" content="{{ eleventy.generator }}">

  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="en_US">
  <meta property="og:type" content="website">

  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/feed.xml">


  <link rel="icon" href="/assets/favicon.png">

  <link rel="stylesheet" href="/assets/style.css">
</head>
<body>
<a href="#main-content" class="skip-link">Skip to main content</a>
{% include "partials/header-website.njk" -%}
<main id="main-content" tabindex="-1">
    {{ content | safe }}
</main>
{% include "partials/footer.njk" %}

<script>
  // Load environment variables if they exist (for production deployment)
  window.env = window.env || {};
</script>
<script src="/assets/scripts/blog-comments.js"></script>
</body>
</html>
