<h2>Essays</h2>
{% set currentYear = "" %}
{% for essay in collections.essays | reverse -%}
  {% set essayYear = essay.data.date | getYear %}
  {% if essayYear != currentYear %}
    {% if currentYear != "" %}</ul>{% endif %}
    <ul class="no-list-style">
    {% set currentYear = essayYear %}
  {% endif %}
  <li>
      <a href="{{ essay.url }}" class="h-entry">{{ essay.data.title }}</a>
      {% if essay.data.popular %}
        <span class="chip"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.25" viewBox="0 0 24 24"><path d="m17 11-5-5-5 5M17 18l-5-5-5 5"/></svg></span>
      {% endif %}
  </li>
{% endfor -%}
</ul>
