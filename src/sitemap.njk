---
layout: layouts/base.njk
title: Sitemap
permalink: /sitemap/
eleventyExcludeFromCollections: true
---

This sitemap for humans is automatically generated.

<h2>Essays</h2>
<ul class="no-list-style">
{% for post in collections.essays | sort(false, false, 'data.title') %}
  <li><a href="{{ post.url }}">{{ post.data.title }}</a></li>
{% endfor %}
</ul>

<h2>Pages</h2>
<ul class="no-list-style">
{% for item in collections.all | sort(false, false, 'data.title') %}
  {% if not item.data.eleventyExcludeFromCollections and item.url and item.url != "/" and item.url != "/sitemap/" and item.url != "/slashes/" and not item.url.startsWith("/assets/") %}
    {% if not item.data.tags or "essays" not in item.data.tags %}
      <li><a href="{{ item.url }}">{{ item.data.title or item.url }}</a></li>
    {% endif %}
  {% endif %}
{% endfor %}
</ul>
