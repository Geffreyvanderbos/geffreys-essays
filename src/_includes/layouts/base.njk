<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} – Geffrey van der Bos</title>
  {%- set pageDescription = description or (content | excerpt) or site.description %}
  <meta name="description" content="{{ pageDescription }}">
  <meta name="author" content="{{ site.author }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/feed.xml">
  <link rel="icon" href="/assets/favicon.png">
  <link rel="stylesheet" href="/assets/style.css">
  {%- if tags and ("essays" in tags) %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ title | dump | safe }},
    "description": {{ pageDescription | dump | safe }},
    "url": "{{ site.url }}{{ page.url }}",
    {% if date %}"datePublished": "{{ date | htmlDate }}",{% endif %}
    "author": {
      "@type": "Person",
      "name": {{ site.author | dump | safe }},
      "url": "{{ site.url }}"
    },
    "publisher": {
      "@type": "Person",
      "name": {{ site.author | dump | safe }},
      "url": "{{ site.url }}"
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "{{ site.url }}{{ page.url }}"
    }
  }
  </script>
  {% else %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ site.name | dump | safe }},
    "url": "{{ site.url }}",
    "description": {{ site.description | dump | safe }},
    "author": {
      "@type": "Person",
      "name": {{ site.author | dump | safe }},
      "url": "{{ site.url }}"
    }
  }
  </script>
  {% endif -%}
  {%- if robots == "noindex" %}
    <meta name="robots" content="noindex">
  {% endif -%}
</head>
<body>
<a href="#main-content" class="skip-link">Skip to main content</a>
{% include "partials/header-website.njk" -%}
<main id="main-content" tabindex="-1">
    {{ content | safe }}
</main>
{% include "partials/footer.njk" %}
</body>
</html>
