      <a class="u-url p-name" href="https://geff.re">Geffrey van der Bos</a>
    </div>
    <span class="block mb-64 muted-text small">
    <time class="dt-published" datetime="{{ date | formatDate('iso') }}">{{ date | formatDate }}</time>
    · I reply to every <a class="muted-text" href="https://signal.me/#eu/d0xsyTaUj-fOp_ycZ0tJmy3mHSljfhIZjTSie9jKsmn_fEGEEM1KAKMmw3jFqzuz" alt="Signal user @geffrey.01">message on Signal</a>
    · <a class="u-url" href="{{ page.url }}">permalink</a></span>
    <div class="e-content">
    {{ content | safe }}
    {% include "partials/comments.njk" %}
    </div>
</article>
